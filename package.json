{
  "name": "@choosek/concentric",
  "version": "0.1.0",
  "description": "Library that provides static confidentiality analysis for Solidity contracts targeting the Arc Privacy Sector.",
  "license": "MIT",
  "homepage": "https://github.com/choosek/concentric-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choosek/concentric-ts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "bin": {
    "concentric": "bin/concentric.mjs"
  },
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "test": "vitest run",
    "lint": "biome check",
    "typecheck": "tsc",
    "attw": "attw --pack .",
    "install-hooks": "lefthook install"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "2.0.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@types/node": "^24.0.4",
    "@types/semver": "^7.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "coveralls": "^3.1.1",
    "lefthook": "^1.11.14",
    "semver": "^7.7.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "bin"
  ],
  "packageManager": "pnpm@10.12.2",
  "dependencies": {
    "@solidity-parser/parser": "^0.20.2"
  }
}
